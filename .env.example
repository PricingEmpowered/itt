# Price Space server configuration.
# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection.
# Run migrations as the owning role, but point the SERVER at a
# least-privilege role that has been granted `authenticated` -- owners and
# superusers bypass row-level security. See db/README.md.
DATABASE_URL=postgres://pricespace_app:change-me@localhost:5432/pricespace

# Signs the session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Optional.
PORT=3000
SESSION_TTL_HOURS=12
DOCUMENT_ROOT=./var/documents
